# =============================================================================
# CodeFlow AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it contains secrets!)
# =============================================================================

# GitHub App Configuration
# Get these from: https://github.com/settings/apps
GITHUB_APP_ID=your_app_id_here
GITHUB_PRIVATE_KEY_PATH=./config/private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_INSTALLATION_ID=your_installation_id_here

# LLM API Keys (we'll get these later)
# Groq: https://console.groq.com/keys (FREE - 14,400 requests/day)
GROQ_API_KEY=your_groq_key_here

# Optional: OpenAI (for comparison testing)
OPENAI_API_KEY=your_openai_key_here

# Database Configuration
# Qdrant Cloud: https://cloud.qdrant.io (FREE tier)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# Neo4j Aura: https://console.neo4j.io (FREE tier)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Supabase: https://supabase.com (FREE tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security
SECRET_KEY=generate_a_random_secret_key_here
